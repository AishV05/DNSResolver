DNS_PORT=5354
DNS_HEALTH_PORT=8080
DNS_REQUESTS_PER_SECOND=100
DNS_REQUEST_BURST_CAPACITY=200
DNS_TCP_MAX_CONNECTIONS=200
DNS_TCP_MAX_CONNECTIONS_PER_CLIENT=20
DNS_TCP_ACCEPT_BACKLOG=128
DNS_TCP_IDLE_TIMEOUT_MILLIS=10000
DNS_TCP_MESSAGE_TIMEOUT_MILLIS=5000
DNS_TCP_MAX_QUERIES_PER_CONNECTION=100
DNS_TCP_MAX_REQUEST_BYTES=65535
DNS_UPSTREAM_TIMEOUT_MILLIS=2000
DNS_UPSTREAM_MAX_ATTEMPTS=2

# The resolver runs in REQUIRED policy mode under Compose. This path is a
# Docker secret source, not the token value. Create/rotate it with
# scripts/provision-policy-reader.py after admin-api is initialized.
DNS_POLICY_READER_TOKEN_FILE=./config/policy-snapshot-reader-token
DNS_POLICY_CONNECT_TIMEOUT_MILLIS=2000
DNS_POLICY_REQUEST_TIMEOUT_MILLIS=5000
DNS_POLICY_REFRESH_INTERVAL_MILLIS=30000
DNS_POLICY_INITIAL_BACKOFF_MILLIS=1000
DNS_POLICY_MAX_BACKOFF_MILLIS=30000
DNS_POLICY_MAX_RESPONSE_BYTES=1048576
DNS_POLICY_MAX_RULES=10000

# Prometheus is published only to localhost by Compose. Metrics are retained in
# the named prometheus-data volume for this duration. The private DNS metrics
# listener always uses container port 9091 in this Compose deployment.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=7d

# Grafana is also published only to localhost by Compose. Set a strong password
# before starting the stack; do not commit the completed config/local.env file.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Local Compose control-plane settings. Generate and set every blank secret
# value before first start; this file is a safe template, not runnable as-is.
# Host port for the localhost-only Admin API mapping; the container listens on 8081.
DNS_ADMIN_PORT=8081
DNS_ADMIN_DB_NAME=dns_admin
DNS_ADMIN_DB_USERNAME=dns_admin
DNS_ADMIN_DB_PASSWORD=
DNS_ADMIN_DB_POOL_SIZE=5
DNS_ADMIN_BOOTSTRAP_USERNAME=bootstrap-admin
DNS_ADMIN_BOOTSTRAP_TOKEN=
