{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DNS resolver reporting session lease v1",
  "description": "Server-issued identity and ordering lease for one resolver process boot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resolverId",
    "sessionId",
    "bootId",
    "sessionGeneration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resolverId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "bootId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "sessionGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
