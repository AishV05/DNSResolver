{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DNS resolver reporting session start v1",
  "description": "Client request for a server-bound resolver reporting session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bootId",
    "applicationVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bootId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "applicationVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]{0,63}$"
    }
  }
}
