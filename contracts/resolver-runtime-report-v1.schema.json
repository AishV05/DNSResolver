{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DNS resolver policy runtime report v1",
  "description": "Ordered, privacy-safe policy state reported by one resolver session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "bootId",
    "sessionGeneration",
    "sequence",
    "applicationVersion",
    "policyMode",
    "policySnapshotLoaded",
    "policyRevision",
    "policyRuleCount",
    "policyReady",
    "policySyncState"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "bootId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "sessionGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "applicationVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]{0,63}$"
    },
    "policyMode": {
      "type": "string",
      "pattern": "^(DISABLED|REQUIRED)$"
    },
    "policySnapshotLoaded": {
      "type": "boolean"
    },
    "policyRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "policyRuleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "policyReady": {
      "type": "boolean"
    },
    "policySyncState": {
      "type": "string",
      "pattern": "^(DISABLED|AWAITING_INITIAL_SNAPSHOT|HEALTHY|DEGRADED|STALE)$"
    }
  }
}
