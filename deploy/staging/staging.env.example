# Non-secret settings for the private staging host. Copy this file outside the repository,
# keep it owner-readable, and set the private interface address before use.
# Application image references are deliberately absent: the verified release
# process generates compose.release.yaml with exact repository@sha256 digests.

# Required. Use an address assigned to a private host interface, never 0.0.0.0.
STAGING_DNS_BIND_ADDRESS=
STAGING_DNS_PORT=5354

# These services remain host-loopback-only. Reach them through an authenticated
# management session or tunnel; do not publish them on a public interface.
STAGING_ADMIN_PORT=8081
STAGING_PROMETHEUS_PORT=9090
STAGING_GRAFANA_PORT=3000

# This directory is outside the generated release bundle. The host operator
# creates owner-only files named postgres-password, grafana-admin-password, and
# policy-snapshot-reader-token. Normal deployments also use
# admin-operator-token only for the authenticated post-deploy check. First
# initialization uses admin-bootstrap-token and provisions the reader token.
STAGING_SECRETS_DIR=/etc/dns-platform/staging/secrets

# Host-local operational state. These directories contain verified deployment
# bundles and database backups; keep them owner-only and outside the repository.
STAGING_STATE_DIR=/var/lib/dns-platform-staging
STAGING_BACKUP_DIR=/var/backups/dns-platform-staging

DNS_WORKER_THREADS=10
DNS_WORKER_QUEUE_CAPACITY=200
DNS_MAX_REQUEST_BYTES=4096
DNS_REQUESTS_PER_SECOND=100
DNS_REQUEST_BURST_CAPACITY=200
DNS_TCP_MAX_CONNECTIONS=200
DNS_TCP_MAX_CONNECTIONS_PER_CLIENT=20
DNS_TCP_ACCEPT_BACKLOG=128
DNS_TCP_IDLE_TIMEOUT_MILLIS=10000
DNS_TCP_MESSAGE_TIMEOUT_MILLIS=5000
DNS_TCP_MAX_QUERIES_PER_CONNECTION=100
DNS_TCP_MAX_REQUEST_BYTES=65535
DNS_METRICS_INTERVAL_SECONDS=60
DNS_UPSTREAM_TIMEOUT_MILLIS=2000
DNS_UPSTREAM_MAX_ATTEMPTS=2
DNS_POLICY_CONNECT_TIMEOUT_MILLIS=2000
DNS_POLICY_REQUEST_TIMEOUT_MILLIS=5000
DNS_POLICY_REFRESH_INTERVAL_MILLIS=30000
DNS_POLICY_INITIAL_BACKOFF_MILLIS=1000
DNS_POLICY_MAX_BACKOFF_MILLIS=30000
DNS_POLICY_MAX_RESPONSE_BYTES=1048576
DNS_POLICY_MAX_RULES=10000

DNS_ADMIN_DB_NAME=dns_admin
DNS_ADMIN_DB_USERNAME=dns_admin
DNS_ADMIN_DB_POOL_SIZE=5

PROMETHEUS_RETENTION_TIME=7d
GRAFANA_ADMIN_USER=admin

# Used only with compose.bootstrap.yaml on an empty database. The token itself
# belongs in STAGING_SECRETS_DIR/admin-bootstrap-token, never in this file.
STAGING_BOOTSTRAP_USERNAME=bootstrap-admin
